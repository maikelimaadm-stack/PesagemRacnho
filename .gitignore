/release/
/release-unsigned/
/release-archive/
# Qualquer pasta de release na raiz (ex.: release-1.4.0/) e instaladores em qualquer lugar
/release*/
*.exe
*.blockmap
coverage/

# Ambiente e segredos
.env
.env.*

# Logs
*.log
logs/
npm-debug.log*

# Temporários e cache local de desenvolvimento
tmp/
.tmp/
.audit-tmp/
.userdata-dev/
.claude/
*.local

# Dados locais de desenvolvimento (legado JSON/SQLite)
data/*.json
data/*.db
data/backups/
data/logs/

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
